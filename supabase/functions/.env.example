# Sandbox e produção usam chaves, URLs e webhooks diferentes.
# A chave de sandbox contém _hmlg_. A chave de produção contém _prod_.
# Criar cobrança em produção exige ASAAS_PRODUCAO_LIBERADA=sim ou o par de teste abaixo.
# A conciliação só consulta cobranças já gravadas e não usa esses interruptores para criar Pix.
# Não grave estes valores no frontend nem no Git.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
CONCILIACAO_TOKEN=
ASAAS_AMBIENTE=sandbox
# ASAAS_PRODUCAO_LIBERADA=
# ASAAS_TESTE_LIBERADO=
# ASAAS_CONTA_TESTE=
# Opcional e só para o servidor local. Aceito apenas em sandbox e só se for http://127.0.0.1 ou http://localhost.
# ASAAS_BASE_URL=
